# Optional settings for backend/.env - the bot runs fully offline with none of them.
# There are no API keys: all intent classification and retrieval happens locally.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum classifier probability required before an intent is trusted.
# Anything below this routes to the fallback response instead of guessing.
INTENT_CONFIDENCE_THRESHOLD=0.30

# Minimum retrieval score for a catalog document to count as a match.
RETRIEVAL_SCORE_FLOOR=0.05
